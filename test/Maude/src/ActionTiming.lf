target C

@maude(
  analysis="reachability",
  timeBound=2,
  goal="last in ActionTiming == 1"
)
main reactor ActionTiming {
  state last: int = 0
  logical action step(1000 usec, 2 msec, "update"): int

  reaction(startup) -> step {=
    lf_schedule_int(step, 0, 1);
  =}

  reaction(step) {=
    self->last = step->value;
  =}
}
