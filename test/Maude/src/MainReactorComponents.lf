target C

@maude(
  analysis="ltl",
  timeBound=2,
  goal="<> (count in MainReactorComponents == 2)"
)
@maude(
  analysis="reachability",
  timeBound=2,
  goal="count in MainReactorComponents == 2"
)
@maude(
  analysis="simulation",
  timeBound=2,
  rewrites=6
)
main reactor MainReactorComponents {
  state count: int = 0
  logical action step: int
  timer tick(0, 1 msec)

  reaction(tick) -> step {=
    lf_schedule_int(step, 0, self->count + 1);
  =}

  reaction(step) {=
    self->count = step->value;
  =}
}
