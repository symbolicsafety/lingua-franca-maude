target C

@maude(
    analysis = "ltl",
    timeBound = 2000,
    timeBoundUnit = "usec",
    goal = "<> (count in OneShotTimer == 1)")
@maude(analysis = "ltl", timeBound = 2, goal = "[] (count in OneShotTimer <= 1)")
main reactor OneShotTimer {
  state count: int = 0
  timer once(1 msec)

  reaction(once) {=
    self->count = self->count + 1;
  =}
}
