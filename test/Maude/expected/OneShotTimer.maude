            outports : none,
            state :
                ( OneShotTimer.m-sv.count |-> [0] ),
            timers :
                < OneShotTimer.m-t.once : Timer | offset : 1000000, period : 0 >,
            actions : none,
            reactions :
                (reaction when (OneShotTimer.m-t.once) do {
                    (OneShotTimer.m-sv.count := (OneShotTimer.m-sv.count + [1]))
                })
        >
    .
endom

